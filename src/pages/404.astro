---
// A page that isn't here.
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
	<main class="wrap pt-7.5 pb-20">
		<h1 class="rise text-display font-bold max-md:text-display-sm">Nothing pinned <em class="text-primary-600 not-italic dark:text-primary-400">here.</em></h1>
		<p class="rise mt-5.5 mb-7 max-w-lede text-lede text-neutral-600 dark:text-neutral-400" style="--i:1">That page isn't on the board. Try the home page, or see what the members have pinned.</p>
		<div class="rise flex flex-wrap gap-3" style="--i:2">
			<a class="btn-brass button" href="/">Go home</a>
			<a class="btn-ghost button" href="/board">Read the board</a>
		</div>
	</main>
</Base>
