---
// A post pinned to the cork: who pinned it, its title and words, a photo if it has one, and its small line. An event
// is on oxblood. `i` staggers the notes as they settle on their pins.
import { getEntry, render, type CollectionEntry } from "astro:content";
import { photoUrl, postMeta } from "../lib/club";

interface Props {
	post: CollectionEntry<"posts">;
	i: number;
}

const { post, i } = Astro.props;
const author = (await getEntry(post.data.author))!;
const { Content } = await render(post);
const event = post.data.kind === "event";
const muted = event ? "text-tertiary-300" : "text-neutral-600";
---

<article class:list={["note", event && "bg-secondary-800 text-tertiary-100 dark:bg-secondary-700"]} style={`--i:${i};--tilt:${post.data.tilt}deg`}>
	<span aria-hidden="true" class="absolute -top-2 left-1/2 size-4 -translate-x-1/2 rounded-pill bg-secondary-800 shadow-pin dark:bg-secondary-700"></span>
	<a class="flex items-center gap-2.5 text-label" href={`/members/${author.id}`}>
		<img class="size-9 rounded-pill object-cover" src={photoUrl(author.data.photo.id, 120)} width="36" height="36" alt="" />
		<span><b class="block">{author.data.name}</b><span class:list={["text-tiny", muted]}>{author.data.byline}</span></span>
	</a>
	<h3 class="mt-3.5 mb-2 text-title-xs">{post.data.title}</h3>
	<div class="text-note"><Content /></div>
	{post.data.photo && <img class="mt-3 aspect-16/10 w-full rounded-photo object-cover" loading="lazy" src={photoUrl(post.data.photo.id, 800)} width="800" height="500" alt={post.data.photo.alt} />}
	<div class:list={["mt-3 flex gap-3.5 text-caption", muted]}>{postMeta(post).map((part) => <span>{part}</span>)}</div>
</article>
